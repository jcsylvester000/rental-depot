# Rental Depot — environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# --- Database (Neon Postgres) — used from Phase 6 ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require"

# --- Cloudinary (document/image hosting) — used from Phase 7 ---
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# --- App ---
# Same-origin in the browser by default. Set for the mobile app / cross-origin API calls.
NEXT_PUBLIC_API_BASE_URL=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
