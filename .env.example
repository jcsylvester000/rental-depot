# Rental Depot — environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# --- Database (Neon Postgres) — used from Phase 6 ---
# Pooled endpoint (runtime); Direct endpoint without "-pooler" (migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require"

# --- Cloudinary (document/image hosting) — used from Phase 7 ---
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# --- Auth (Auth.js) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="your-random-secret"

# --- Chat retention cron ---
# Shared secret the daily Netlify scheduled function (netlify/functions/purge-chats)
# sends to /api/v1/cron/purge-chats. Set the SAME value in Netlify's env.
CRON_SECRET="another-random-secret"

# --- App ---
# Same-origin in the browser by default. Set for the mobile app / cross-origin API calls.
NEXT_PUBLIC_API_BASE_URL=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
